# 認証設定
# AUTH_SECRET は以下で生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your-secret-here-change-this-in-production
AUTH_PASSWORD=your-password-here

# データベース (Vercel Postgres - vercel env pull で自動取得される)
POSTGRES_PRISMA_URL=postgresql://...
POSTGRES_URL_NON_POOLING=postgresql://...

# Vercel Blob (Vercelダッシュボードの Storage タブから自動設定)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token-here
